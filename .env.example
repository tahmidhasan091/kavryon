# Kavryon production / development environment (never commit real secrets)

NODE_ENV=development
PORT=8080
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32PLUS

# SQLite path (persistent volume in production)
KAVRYON_DB=/tmp/kavryon.sqlite

# Payments: must be false in production
SANDBOX_PAYMENTS=true

# Google Play (production only; service account on server only)
GOOGLE_PLAY_PACKAGE=com.kavryon.platform
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/play-sa.json

# Owner bootstrap (optional)
# ADMIN_BOOTSTRAP_USERNAME=kavryon_admin
# ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME
# OWNER_USER_ID=

# CORS
# ALLOWED_ORIGINS=https://your-domain.com,https://appassets.androidplatform.net

# Multiplayer (optional Redis)
# MULTIPLAYER_MODE=memory
# REDIS_URL=redis://127.0.0.1:6379

# Video storage
KAVRYON_VIDEO_ROOT=
KAVRYON_VIDEO_MAX_BYTES=52428800
KAVRYON_VIDEO_UPLOADS_PER_HOUR=10

# AI providers (server-side only; never ship to client)
# OPENAI_API_KEY=
# GEMINI_API_KEY=


# Bangladesh payments (SSLCommerz) — server only; leave unset to disable
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_MODE=sandbox
# SSLCOMMERZ_SUCCESS_URL=https://your-domain/payment/success
# SSLCOMMERZ_FAIL_URL=https://your-domain/payment/fail
# SSLCOMMERZ_CANCEL_URL=https://your-domain/payment/cancel
# SSLCOMMERZ_IPN_URL=https://your-api/api/payments/bd/ipn
